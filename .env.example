# VIGIL_CA_CERT=wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem
# VIGIL_TLS_HOSTNAME=wazuh.indexer
# VIGIL_INDEX=wazuh-alerts-*
# VIGIL_TRIAGE_DB=vigil-triage.db
